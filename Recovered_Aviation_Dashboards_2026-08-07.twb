    <dashboard enable-sort-zone-taborder='true' name='Dashboard 5 – Airline Delay Severity'>
      <style />
      <size maxheight='960' maxwidth='1250' minheight='560' minwidth='520' sizing-mode='range' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='37455' id='5' name='Departure Delay Severity by Ailrine' w='98680' x='660' y='7367'>
            <layout-cache type-h='fixed' type-w='fixed' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
