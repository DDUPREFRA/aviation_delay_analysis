              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='53' forceUpdate='true' h='8473' id='7' is-fixed='true' type-v2='text' w='98680' x='660' y='90436'>
            <formatted-text>
              <run fontcolor='#555555' fontname='Benton Sans Book' fontsize='10'>Severity statistics include only flights departing at least 15 minutes late. The median represents a more typical delayed flight, the average is more influenced by extreme delays, and the 90th percentile represents a severe but less exceptional delay. Arrival severity describes arrival outcomes among those departure-delayed flights.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='6276' id='8' type-v2='text' w='98680' x='660' y='1091'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
