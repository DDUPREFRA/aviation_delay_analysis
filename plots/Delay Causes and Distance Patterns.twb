    <worksheet name='Peak vs Off-Peak Performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#555555'>Peak vs Off-Peak Delay Pattern</run>
            <run>Æ&#10;</run>
          </formatted-text>
