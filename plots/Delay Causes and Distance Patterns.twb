      <aliases enabled='yes' />
      <column caption='Delay Cause Label' datatype='string' name='[Calculation_2375663028621323]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [main_delay_cause]&#10;    WHEN &quot;carrier_delay&quot; THEN &quot;Carrier&quot;&#10;    WHEN &quot;late_aircraft_delay&quot; THEN &quot;Late Aircraft&quot;&#10;    WHEN &quot;nas_delay&quot; THEN &quot;National Airspace System&quot;&#10;    WHEN &quot;weather_delay&quot; THEN &quot;Weather&quot;&#10;    WHEN &quot;security_delay&quot; THEN &quot;Security&quot;&#10;    ELSE [main_delay_cause]&#10;END' />
        <aliases>
          <alias key='&quot;National Airspace System&quot;' value='NAS' />
          <alias key='&quot;no_reported_cause&quot;' value='No Reported Cause' />
        </aliases>
